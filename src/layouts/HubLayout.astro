---
import BaseLayout from './BaseLayout.astro';
import LeadForm from '../components/LeadForm.astro';
import FaqBlock from '../components/FaqBlock.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getCardImageUrl } from '../lib/cardImage';
import { SITE } from '../data/site';

export interface HubCard {
  url: string;
  title: string;
  description: string;
  meta?: string;
  badge?: string;
  /** Cloudinary source. The card crops it; pass the page's own heroImage. */
  image?: string;
  /** Overlaid on the photograph: the one number a card is allowed to carry. */
  price?: string;
  /** Corner flag on the photograph: delivery status, and nothing else. */
  flag?: string;
}

export interface HubGroup {
  label: string;
  /** One line saying what this group is for: the reason to have groups at all. */
  note?: string;
  cards: HubCard[];
}

interface Props {
  /** <title>: carries the keyword */
  title: string;
  /** <h1>: matches the title's keyword rather than being a bare section noun */
  heading: string;
  description: string;
  /** Two to four paragraphs of hub copy that exist nowhere else on the site */
  intro: string[];
  path: string;
  groups: HubGroup[];
  faq?: { question: string; answer: string }[];
  /** Newest updatedDate in the collection, for schema freshness */
  lastUpdated?: Date;
  leadTitle?: string;
  leadSubtitle?: string;
  searchable?: boolean;
  /**
   * 'wide' is a 16:9 band: a building, a pool, a coastline read across.
   * 'tall' is 3:2, for the area pages, where a place is carried by its
   * verticals rather than by a panorama.
   */
  cardMedia?: 'wide' | 'tall';
}

const {
  title,
  heading,
  description,
  intro,
  path,
  groups,
  faq = [],
  lastUpdated,
  leadTitle = 'Get a vetted Mexico shortlist',
  leadSubtitle = 'Tell us the budget and the market. We reply within one business day with three to five options and the net yield maths behind each one.',
  searchable = false,
  cardMedia = 'wide',
} = Astro.props;

const pageUrl = `${SITE.url}${path}`;
const allCards = groups.flatMap((g) => g.cards);

const crumbs = [
  { label: 'Home', href: `${SITE.url}/` },
  { label: heading, href: pageUrl },
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((crumb, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: crumb.label,
    item: crumb.href,
  })),
};

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: heading,
  description,
  numberOfItems: allCards.length,
  itemListElement: allCards.slice(0, 100).map((card, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `${SITE.url}${card.url}`,
    name: card.title,
  })),
};

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description,
  url: pageUrl,
  inLanguage: 'en-US',
  ...(lastUpdated ? { dateModified: lastUpdated.toISOString() } : {}),
};

const faqSchema = faq.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
} : null;

const schemas = [
  collectionSchema,
  breadcrumbSchema,
  itemListSchema,
  ...(faqSchema ? [faqSchema] : []),
];

/** Anchor slug for the in-page group nav. */
const anchor = (label: string) => label.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

/*
 * The photographs are the reason this layout changed, and the guides hub holds
 * 144 of them. Everything below the first screen is lazy; the opening row is
 * not, because a card that pops in after paint is the thing lazy loading is
 * supposed to prevent. Six covers the widest grid's first row plus one.
 *
 * Numbering has to run across groups rather than restart inside each one, so
 * the index is assigned here instead of inside the group loop.
 */
const EAGER_CARDS = 6;
/*
 * The card photograph carries alt="" on purpose. The link around it is already
 * labelled by the title sitting under the picture, so a described thumbnail
 * makes a screen reader announce the same page twice. The article hero is the
 * opposite case and keeps its real alt: there the picture is the page's own
 * topical image and nothing else names it.
 */
const mediaSize = cardMedia === 'tall' ? 'cardTall' : 'card';
const mediaWidth = 800;
const mediaHeight = cardMedia === 'tall' ? 534 : 450;

let cardIndex = 0;
const renderGroups = groups.map((group) => ({
  ...group,
  cards: group.cards.map((card) => ({
    card,
    index: cardIndex++,
    photo: getCardImageUrl(card.image, mediaSize),
  })),
}));
---
<BaseLayout title={title} description={description} canonical={pageUrl} {schemas}>
  <section class="site-container py-10 md:py-14">
    <header class="max-w-3xl mb-10">
      <Breadcrumbs crumbs={crumbs.map((c, i) => ({
        label: c.label,
        href: i === crumbs.length - 1 ? undefined : c.href,
      }))} />
      <h1 class="text-3xl md:text-4xl mb-4">{heading}</h1>
      {intro.map((paragraph) => (
        <p class="text-base md:text-lg text-[var(--color-muted)] mb-4">{paragraph}</p>
      ))}
      <p class="text-sm text-[var(--color-muted)]">
        {allCards.length} pages across {groups.length} sections.
        {lastUpdated && ` Last updated ${lastUpdated.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}.`}
      </p>
    </header>

    {searchable && (
      <div class="hub-search">
        <label for="hub-search-input">Find a guide</label>
        <input id="hub-search-input" type="search" placeholder={`Search ${allCards.length} guides`} autocomplete="off" />
        <p id="hub-search-count" aria-live="polite">{allCards.length} guides</p>
      </div>
    )}

    {groups.length > 1 && (
      <nav class="hub-nav" data-hub-nav aria-label="Sections on this page">
        <ul>
          {groups.map((group) => (
            <li><a href={`#${anchor(group.label)}`}>{group.label}</a></li>
          ))}
        </ul>
      </nav>
    )}

    {renderGroups.map((group) => (
      <section class="mb-14" id={anchor(group.label)} data-hub-group>
        <h2 class="text-xl md:text-2xl mb-1">{group.label}</h2>
        {group.note && <p class="text-sm text-[var(--color-muted)] mb-5 max-w-2xl">{group.note}</p>}
        <ul class="hub-grid">
          {group.cards.map(({ card, index, photo }) => (
            <li data-hub-card data-search={`${card.title} ${card.description} ${card.badge ?? ''}`.toLowerCase()}>
              <a href={card.url} class:list={['hub-card', photo && 'hub-card--photo', cardMedia === 'tall' && 'hub-card--tall']}>
                {photo && (
                  <span class="hub-card__media">
                    <img
                      src={photo}
                      alt=""
                      data-decorative
                      loading={index < EAGER_CARDS ? 'eager' : 'lazy'}
                      fetchpriority={index < EAGER_CARDS ? 'high' : 'auto'}
                      decoding="async"
                      width={mediaWidth}
                      height={mediaHeight}
                    />
                    {card.price && <span class="hub-card__price">{card.price}</span>}
                    {card.flag && <span class="hub-card__flag">{card.flag}</span>}
                  </span>
                )}
                <span class="hub-card__body">
                  {card.badge && <span class="hub-card__badge">{card.badge}</span>}
                  <span class="hub-card__title">{card.title}</span>
                  <span class="hub-card__desc">{card.description}</span>
                  {card.meta && <span class="hub-card__meta">{card.meta}</span>}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}

    {searchable && <p id="hub-search-empty" class="hub-search__empty" hidden>No guides match that search.</p>}

    <div class="max-w-3xl mx-auto mt-4">
      <LeadForm title={leadTitle} subtitle={leadSubtitle} context={heading} formLocation="bottom" />
    </div>

    {faq.length > 0 && (
      <div class="max-w-3xl mx-auto">
        <FaqBlock items={faq} />
      </div>
    )}
  </section>
</BaseLayout>

<style>
  .hub-nav {
    margin: 0 0 2.5rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-surface);
  }
  .hub-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.1rem;
    font-size: 0.85rem;
  }
  .hub-nav a { color: var(--color-muted); text-decoration: none; }
  .hub-nav a:hover { color: var(--color-accent); text-decoration: underline; }

  .hub-search {
    max-width: 36rem;
    margin-bottom: 2rem;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    background: var(--color-surface);
  }
  .hub-search label {
    display: block;
    margin-bottom: 0.45rem;
    color: var(--color-ink);
    font-size: 0.85rem;
    font-weight: 600;
  }
  .hub-search input { width: 100%; }
  .hub-search p {
    margin: 0.45rem 0 0;
    color: var(--color-muted);
    font-size: 0.8rem;
  }
  .hub-search__empty {
    padding: 2rem 0;
    color: var(--color-muted);
    text-align: center;
  }

  .hub-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.1rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) { .hub-grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1024px) { .hub-grid { grid-template-columns: repeat(3, 1fr); } }

  /*
   * Every page in every collection already carried a heroImage; the hub just
   * never asked for it, so 354 photographs sat behind a wall of grey text.
   * The card is now the photograph first: it is the only part a reader looks
   * at before deciding whether to open the page.
   */
  .hub-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-photo);
    background: var(--color-surface);
    text-decoration: none;
    overflow: hidden;
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }
  .hub-card:hover {
    border-color: var(--color-brass);
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgb(18 41 43 / 10%);
  }
  /* A card with no photograph keeps its old padding, so a collection that has
   * not been shot yet degrades to the previous card rather than to a gap. */
  .hub-card:not(.hub-card--photo) { padding: 1rem 1.1rem; }

  .hub-card__media {
    display: block;
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-surface-muted);
    border-bottom: 1px solid var(--color-border-soft);
  }
  .hub-card--tall .hub-card__media { aspect-ratio: 3 / 2; }
  .hub-card__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .hub-card:hover .hub-card__media img { transform: scale(1.04); }

  /* Cenote ground under brass, the same pair the hero plate uses, because the
   * plate has to hold its contrast over whatever the photograph puts behind
   * it: sand, sky and white facades all defeat a light chip. */
  .hub-card__price {
    position: absolute;
    left: 0.7rem;
    bottom: 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.05em;
    font-variant-numeric: tabular-nums;
    color: var(--color-cream);
    background: rgb(7 38 42 / 88%);
    border: 1px solid rgb(214 167 92 / 45%);
    border-radius: calc(var(--radius-photo) * 0.6);
    padding: 0.28rem 0.6rem;
    backdrop-filter: blur(3px);
  }
  .hub-card__flag {
    position: absolute;
    right: 0.7rem;
    top: 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-deep);
    background: var(--color-brass-light);
    border-radius: calc(var(--radius-photo) * 0.6);
    padding: 0.22rem 0.5rem;
  }

  .hub-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .hub-card--photo .hub-card__body { padding: 0.9rem 1.05rem 1.05rem; }

  .hub-card__badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.63rem;
    font-weight: 500;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 0.35rem;
  }
  .hub-card--photo .hub-card__title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 1.14rem;
    line-height: 1.2;
  }
  .hub-card__title {
    display: block;
    font-weight: 600;
    font-size: 0.95rem;
    line-height: 1.35;
    color: var(--color-ink);
    margin-bottom: 0.3rem;
  }
  .hub-card__desc {
    display: block;
    font-size: 0.82rem;
    line-height: 1.45;
    color: var(--color-muted);
  }
  /* Two lines, so a long SEO description cannot set the height of a whole row. */
  .hub-card--photo .hub-card__desc {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .hub-card__meta {
    display: block;
    margin-top: 0.5rem;
    font-size: 0.72rem;
    color: var(--color-muted);
  }
  .hub-card--photo .hub-card__meta {
    margin-top: auto;
    padding-top: 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
  }
</style>

<script>
  (function () {
    var input = document.getElementById('hub-search-input');
    var count = document.getElementById('hub-search-count');
    var empty = document.getElementById('hub-search-empty');
    var nav = document.querySelector('[data-hub-nav]');
    var cards = Array.prototype.slice.call(document.querySelectorAll('[data-hub-card]'));
    var groups = Array.prototype.slice.call(document.querySelectorAll('[data-hub-group]'));
    if (!input || !count || !empty) return;

    input.addEventListener('input', function () {
      var query = input.value.trim().toLowerCase();
      var visible = 0;
      cards.forEach(function (card) {
        var show = !query || (card.dataset.search || '').includes(query);
        card.hidden = !show;
        if (show) visible += 1;
      });
      groups.forEach(function (group) {
        group.hidden = Boolean(query) && !group.querySelector('[data-hub-card]:not([hidden])');
      });
      if (nav) nav.hidden = Boolean(query);
      count.textContent = visible + (visible === 1 ? ' guide' : ' guides');
      empty.hidden = visible !== 0;
    });
  })();
</script>
