---
import globalStyles from '../styles/global.css?url';
import instrumentSerif400 from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import instrumentSans400 from '@fontsource/instrument-sans/files/instrument-sans-latin-400-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import WhatsAppIntentTracker from '../components/WhatsAppIntentTracker.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import CurrencyEngine from '../components/CurrencyEngine.astro';
import { SITE } from '../data/site';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  schemas?: object[];
  publishedTime?: string;
  modifiedTime?: string;
  /** LCP hero — preload mobile variant for faster first paint */
  preloadImage?: string;
  preloadImageSrcset?: string;
  preloadImageSizes?: string;
}

const {
  title,
  description = SITE.description,
  canonical = Astro.url.href,
  ogImage = `${SITE.url}/og-default.png`,
  type = 'website',
  noindex = false,
  schemas = [],
  publishedTime,
  modifiedTime,
  preloadImage,
  preloadImageSrcset,
  preloadImageSizes,
} = Astro.props;

/**
 * Google truncates the SERP title around 60 characters. The brand suffix costs 16,
 * so append it only when the result still fits; a truncated title loses the tail of
 * the headline, which is where the keyword usually is.
 */
const TITLE_SUFFIX = ' | Mexico Invest';
const TITLE_MAX = 60;
const fullTitle =
  title.includes('Mexico Invest') || title.length + TITLE_SUFFIX.length > TITLE_MAX
    ? title
    : `${title}${TITLE_SUFFIX}`;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  email: SITE.email,
  logo: { '@type': 'ImageObject', url: `${SITE.url}/favicon.svg` },
  contactPoint: {
    '@type': 'ContactPoint',
    email: SITE.email,
    contactType: 'customer service',
    availableLanguage: ['English', 'Spanish'],
  },
  sameAs: [
    SITE.url,
    ...SITE.sameAs,
    ...(SITE.wikidataId ? [`https://www.wikidata.org/wiki/${SITE.wikidataId}`] : []),
  ],
};

const allSchemas = [orgSchema, ...schemas];
---
<!doctype html>
<html lang="en" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#07262a" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {noindex
    ? <meta name="robots" content="noindex,nofollow" />
    : <meta name="robots" content="index,follow,max-image-preview:large" />}
  {!noindex && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content={type} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:site_name" content={SITE.name} />
  {type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
  {type === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <link rel="icon" href="/favicon.svg?v=3" type="image/svg+xml" />
  <link rel="icon" href="/favicon-32.png?v=3" type="image/png" sizes="32x32" />
  <link rel="icon" href="/favicon-16.png?v=3" type="image/png" sizes="16x16" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=3" sizes="180x180" />
  <link rel="manifest" href="/site.webmanifest" />

  <link rel="preload" href={instrumentSerif400} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={instrumentSans400} as="font" type="font/woff2" crossorigin />

  <link rel="preconnect" href="https://res.cloudinary.com" crossorigin />
  <link rel="dns-prefetch" href="https://res.cloudinary.com" />

  {preloadImage && (
    <link
      rel="preload"
      as="image"
      href={preloadImage}
      fetchpriority="high"
      {...(preloadImageSrcset ? { imagesrcset: preloadImageSrcset, imagesizes: preloadImageSizes } : {})}
    />
  )}

  <!-- Critical above-the-fold CSS (first paint before full bundle) -->
  <style is:inline>
    :root {
      --site-header-h: 64px;
      --color-page: #f1ece3;
      --color-deep: #07262a;
      --color-deep-line: #1b4247;
      --color-cream: #f1ece3;
      --color-cream-dim: #c3bcaf;
      --color-accent: #175e5c;
      --color-brass-light: #d6a75c;
      --font-serif: 'Instrument Serif', Georgia, 'Times New Roman', serif;
      --font-sans: 'Instrument Sans', system-ui, -apple-system, 'Segoe UI', sans-serif;
      --font-mono: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
    }
    html { -webkit-font-smoothing: antialiased; }
    body {
      margin: 0;
      background: var(--color-page);
      color: #4a5654;
      font-family: var(--font-sans);
      line-height: 1.65;
      font-size: 1rem;
      min-height: 100dvh;
      display: flex;
      flex-direction: column;
    }
    body > main { flex: 1 0 auto; }
    header {
      position: sticky;
      top: 0;
      z-index: 50;
      background: var(--color-deep);
      border-bottom: 1px solid var(--color-deep-line);
    }
    .hero-band {
      background: var(--color-deep);
      color: var(--color-cream);
      min-height: calc(100svh - var(--site-header-h));
      display: flex;
      flex-direction: column;
    }
    .hero-band h1 {
      font-family: var(--font-serif);
      color: var(--color-cream);
      font-weight: 400;
      line-height: 1.02;
      margin: 0;
    }
    .hero-photo {
      position: relative;
      margin: 0;
      background: #0d3235;
      flex: 1 1 auto;
      min-height: clamp(210px, 34vh, 620px);
      overflow: hidden;
    }
    .hero-photo > img,
    .hero-photo picture img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .btn-primary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: var(--color-accent);
      color: var(--color-cream);
      font-weight: 600;
      border-radius: 2px;
      text-decoration: none;
    }
  </style>

  <link rel="preload" href={globalStyles} as="style" />
  <link rel="stylesheet" href={globalStyles} media="print" onload="this.media='all'" />
  <noscript><link rel="stylesheet" href={globalStyles} /></noscript>

  {allSchemas.map((s) => (
    <script type="application/ld+json" set:html={JSON.stringify(s)} />
  ))}
</head>
<body>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
  <WhatsAppFloat />
  <CurrencyEngine />
  <WhatsAppIntentTracker />
  <GoogleAnalytics />
  <script is:inline>
    // Wide tables scroll. Tell the reader which way, and stop saying it once
    // they get there. Runs once at load and on resize; cheap either way.
    (function () {
      var mark = function (el) {
        var max = el.scrollWidth - el.clientWidth;
        if (max <= 2) { el.removeAttribute('data-scrollable'); el.removeAttribute('data-at'); return; }
        el.setAttribute('data-scrollable', 'true');
        el.setAttribute('data-at', el.scrollLeft <= 1 ? 'start' : el.scrollLeft >= max - 1 ? 'end' : 'middle');
      };
      var init = function () {
        var all = document.querySelectorAll('.table-scroll');
        for (var i = 0; i < all.length; i++) {
          var el = all[i];
          mark(el);
          if (!el.dataset.bound) {
            el.dataset.bound = '1';
            el.addEventListener('scroll', function () { mark(this); }, { passive: true });
          }
        }
      };
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
      else init();
      addEventListener('resize', init, { passive: true });
    })();
  </script>

</body>
</html>
