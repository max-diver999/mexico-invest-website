---
import { SITE } from '../data/site';

const message = 'Hi, I have a question about Mexico property from this website.';
const href = `${SITE.whatsapp}?text=${encodeURIComponent(message)}`;
---
<a
  class="site-wa-float"
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  data-wa-placement="float"
  data-cta="whatsapp_float"
  aria-label="Message us on WhatsApp"
>
  <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" focusable="false">
    <path fill="currentColor" d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.65.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.48-1.75-1.65-2.05-.17-.3-.02-.46.13-.61.14-.14.3-.35.45-.53.15-.18.2-.3.3-.5.1-.2.05-.38-.02-.53-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.38-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.88 1.22 3.08.15.2 2.1 3.2 5.09 4.49.71.31 1.27.49 1.7.63.71.23 1.36.19 1.88.12.57-.09 1.76-.72 2.01-1.42.25-.7.25-1.29.17-1.42-.07-.13-.27-.2-.57-.35M12.05 21.5h-.01a9.4 9.4 0 0 1-4.8-1.32l-.34-.2-3.57.93.96-3.48-.23-.36a9.38 9.38 0 0 1-1.44-5.01c0-5.18 4.22-9.4 9.42-9.4a9.34 9.34 0 0 1 6.65 2.76 9.32 9.32 0 0 1 2.76 6.65c0 5.19-4.22 9.41-9.4 9.41m8-17.4A11.32 11.32 0 0 0 12.05.79C5.8.79.72 5.87.72 12.11c0 1.99.52 3.94 1.51 5.66L.63 23.5l5.86-1.54a11.3 11.3 0 0 0 5.55 1.42h.01c6.24 0 11.32-5.08 11.33-11.32a11.25 11.25 0 0 0-3.32-8.01" />
  </svg>
</a>

<style>
  .site-wa-float {
    position: fixed;
    right: 1rem;
    bottom: calc(1rem + env(safe-area-inset-bottom, 0px));
    z-index: 9991;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 999px;
    background: #25d366;
    color: #fff !important;
    text-decoration: none;
    box-shadow: 0 6px 20px rgba(31, 36, 33, 0.26);
    transition: transform 0.18s ease, bottom 0.18s ease;
  }
  :global(body:has(.sticky-cta[data-visible='true'])) .site-wa-float {
    bottom: calc(5.75rem + env(safe-area-inset-bottom, 0px));
  }
  .site-wa-float:hover { transform: translateY(-2px); color: #fff !important; }
  .site-wa-float:focus-visible { outline: 3px solid var(--color-accent-strong); outline-offset: 3px; }
  @media (prefers-reduced-motion: reduce) { .site-wa-float { transition: none; } }
</style>
