---
import { mdInlineToHtml } from '../lib/md-inline';

interface Props {
  text: string;
}

const { text } = Astro.props;
/** `text` arrives as a prop, so MDX never renders the markdown inside it. */
const html = mdInlineToHtml(text);
---
<aside class="tldr-block" itemprop="abstract">
  <div class="tldr-label">Key Takeaway</div>
  <p set:html={html} />
</aside>

<style>
  .tldr-block {
    border-left: 4px solid var(--color-accent);
    background: linear-gradient(135deg, var(--color-accent-soft) 0%, var(--color-surface) 100%);
    border-radius: 0 12px 12px 0;
    padding: 16px 20px;
    margin: 0 0 24px 0;
    font-size: 15px;
    line-height: 1.65;
    color: var(--color-ink);
  }
  .tldr-label {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent-strong);
    margin-bottom: 6px;
  }
  .tldr-block p {
    margin: 0;
  }
</style>
