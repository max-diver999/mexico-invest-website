---
import { SITE } from '../data/site';
import CurrencyToggle from './CurrencyToggle.astro';

const nav = [
  { label: 'Guides', href: '/guides/' },
  { label: 'Projects', href: '/projects/' },
  { label: 'Areas', href: '/areas/' },
  { label: 'Compare', href: '/compare/' },
  { label: 'Developers', href: '/developers/' },
  { label: 'Market notes', href: '/news/' },
  { label: 'About', href: '/about/' },
];

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---
<header class="sticky top-0 z-50 border-b border-[var(--color-deep-line)] bg-[var(--color-deep)]">
  <div class="site-container site-header__bar flex items-center justify-between gap-4">
    <a href="/" class="site-brand no-underline">
      <img src="/favicon.svg?v=3" alt="" data-decorative width="28" height="28" class="rounded-[2px]" />
      <span class="site-brand__name">{SITE.name}</span>
    </a>

    <nav class="hidden lg:flex items-center gap-5 text-sm font-medium" aria-label="Main">
      {nav.map((item) => (
        <a
          href={item.href}
          aria-current={isCurrent(item.href) ? 'page' : undefined}
          class:list={[
            'site-nav__link no-underline hover:text-[var(--color-cream)]',
            isCurrent(item.href) ? 'text-[var(--color-cream)]' : 'text-[var(--color-cream-dim)]',
          ]}
        >{item.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-2 shrink-0">
      <CurrencyToggle variant="header" />
      <a href="/get-shortlist/" class="btn-primary btn-primary--brass mobile-header-cta text-sm px-4 py-2">Free shortlist</a>
      <button
        type="button"
        id="nav-toggle"
        class="lg:hidden site-nav__toggle"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Open menu"
      >
        <span aria-hidden="true">☰</span>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="site-nav__mobile lg:hidden" aria-label="Main" hidden>
    <ul class="site-container py-3">
      <li><a href="/get-shortlist/" class="site-nav__cta">Get a free shortlist</a></li>
      <li><CurrencyToggle variant="drawer" /></li>
      {nav.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
            class="site-nav__mobile-link no-underline"
          >{item.label}</a>
        </li>
      ))}
      <li>
        <a href="/contact/" class="site-nav__mobile-link no-underline">Contact</a>
      </li>
    </ul>
  </nav>
</header>

<style>
  /* The hero sizes itself against this, so the bar needs a height the CSS
     can name rather than one that falls out of whatever wraps. */
  .site-header__bar {
    min-height: var(--site-header-h, 64px);
    padding-block: 0.5rem;
  }
  .site-brand { display: flex; align-items: center; gap: 0.55rem; flex-shrink: 0; }
  .site-brand__name {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    line-height: 1.1;
    white-space: nowrap;
    color: var(--color-cream);
  }
  .site-nav__link { white-space: nowrap; }

  .site-nav__toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--color-deep-line);
    border-radius: 2px;
    background: transparent;
    font-size: 1.1rem;
    line-height: 1;
    color: var(--color-cream);
    cursor: pointer;
  }
  .site-nav__mobile {
    position: fixed;
    top: 73px;
    left: 0;
    right: 0;
    height: calc(100dvh - 73px);
    z-index: 60;
    background: var(--color-deep);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding-inline: 0;
  }
  .site-nav__mobile ul {
    list-style: none;
    margin: 0;
    padding-block: 0.75rem;
    display: grid;
    gap: 0.125rem;
  }
  .site-nav__cta {
    display: flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.75rem;
    border-radius: 2px;
    background: var(--color-brass-light);
    color: var(--color-deep) !important;
    font-weight: 600;
    text-decoration: none;
  }
  .site-nav__mobile-link {
    display: flex;
    align-items: center;
    min-height: 48px;
    padding: 0.6rem 0.25rem;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--color-cream-dim);
  }
  .site-nav__mobile-link[aria-current='page'] {
    color: var(--color-cream);
  }
  @media (max-width: 767px) {
    .mobile-header-cta { display: none; }
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-nav');
  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      menu.hidden = !open;
      document.body.style.overflow = open ? 'hidden' : '';
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setOpen(false);
    });
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 1024) setOpen(false);
    });
  }
</script>
