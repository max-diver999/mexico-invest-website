---
import { SITE } from '../data/site';
const year = new Date().getFullYear();

const research = [
  { label: 'Investment guides', href: '/guides/' },
  { label: 'Project reviews', href: '/projects/' },
  { label: 'Areas and markets', href: '/areas/' },
  { label: 'Comparisons', href: '/compare/' },
  { label: 'Developers', href: '/developers/' },
  { label: 'Market notes', href: '/news/' },
];

const about = [
  { label: 'About Mexico Invest', href: '/about/' },
  { label: 'How we research', href: '/methodology/' },
  { label: 'Get a shortlist', href: '/get-shortlist/' },
  { label: 'Contact', href: '/contact/' },
];
---
<footer class="mt-16 border-t border-[var(--color-deep-line)] bg-[var(--color-deep)] text-[var(--color-cream-dim)]">
  <div class="site-container py-12 grid gap-8 md:grid-cols-4 text-sm">
    <div>
      <p class="text-lg font-normal font-[var(--font-serif)] text-[var(--color-cream)] mb-2">{SITE.name}</p>
      <p class="leading-relaxed">{SITE.tagline}</p>
      <p class="leading-relaxed mt-3 text-[var(--color-cream-dim)]">
        Independent research for US and Canadian buyers. Not a developer, not a listing portal.
      </p>
    </div>
    <div>
      <p class="font-mono text-[0.68rem] tracking-[0.16em] uppercase text-[var(--color-brass-light)] mb-3">Research</p>
      <ul class="space-y-2">
        {research.map((item) => (
          <li><a href={item.href} class="text-[var(--color-cream-dim)] hover:text-[var(--color-cream)] no-underline">{item.label}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <p class="font-mono text-[0.68rem] tracking-[0.16em] uppercase text-[var(--color-brass-light)] mb-3">Mexico Invest</p>
      <ul class="space-y-2">
        {about.map((item) => (
          <li><a href={item.href} class="text-[var(--color-cream-dim)] hover:text-[var(--color-cream)] no-underline">{item.label}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <p class="font-mono text-[0.68rem] tracking-[0.16em] uppercase text-[var(--color-brass-light)] mb-3">Legal</p>
      <ul class="space-y-2">
        <li><a href="/privacy-policy/" class="text-[var(--color-cream-dim)] hover:text-[var(--color-cream)] no-underline">Privacy</a></li>
        <li><a href="/terms/" class="text-[var(--color-cream-dim)] hover:text-[var(--color-cream)] no-underline">Terms</a></li>
        <li><a href={`mailto:${SITE.email}`} class="text-[var(--color-cream-dim)] hover:text-[var(--color-cream)] no-underline">{SITE.email}</a></li>
      </ul>
    </div>
  </div>
  <div class="site-container py-4 border-t border-[var(--color-deep-line)] text-xs text-[var(--color-cream-dim)]">
    © {year} {SITE.name}. Independent research. Not financial or legal advice. Verify all figures with licensed professionals.
  </div>
</footer>

<style>
  /* The footer link columns were 16px tall targets: a 13px line with no box
   * around it. Each one is a whole list item rather than a link inside a
   * sentence, so the running-text exception in WCAG 2.2 does not apply and
   * they have to reach 24px. Height on the link, not padding on the list, so
   * the columns keep their alignment. */
  footer ul a {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
  }
</style>
