---
interface Props {
  variant?: 'header' | 'drawer';
}
const { variant = 'header' } = Astro.props;
---
<button
  type="button"
  class={`site-fx-toggle site-fx-toggle--${variant}`}
  data-site-fx-toggle
  aria-pressed="false"
  title="Show Mexican peso equivalents alongside US dollar figures"
>
  <span aria-hidden="true">MX$</span>
  <span class="site-fx-toggle__label">Show MXN</span>
</button>

<style>
  .site-fx-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 36px;
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--color-deep-line);
    border-radius: 2px;
    background: transparent;
    color: var(--color-cream-dim);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    font-weight: 500;
    cursor: pointer;
    white-space: nowrap;
  }
  .site-fx-toggle:hover {
    border-color: var(--color-brass-light);
    color: var(--color-cream);
  }
  .site-fx-toggle[aria-pressed='true'] {
    border-color: var(--color-brass-light);
    color: var(--color-brass-light);
  }
  .site-fx-toggle--drawer {
    width: 100%;
    min-height: 44px;
    justify-content: center;
    margin-bottom: 1.25rem;
    font-size: 0.9rem;
  }
  @media (max-width: 1100px) {
    .site-fx-toggle--header { display: none; }
  }
</style>
