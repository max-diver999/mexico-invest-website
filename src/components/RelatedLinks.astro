---
import type { LinkCard } from '../lib/content-graph';
import { getCardImageUrl } from '../lib/cardImage';

interface Props {
  heading: string;
  cards: LinkCard[];
  /** One line under the heading explaining where these links come from. */
  note?: string;
}
const { heading, cards, note } = Astro.props;

/*
 * A square rather than a band. These sit at the foot of a long article, where
 * the reader has already decided to leave; the thumbnail is there to say which
 * place or building is behind the link, not to open a second article.
 */
const withPhoto = cards.map((card) => ({ card, photo: getCardImageUrl(card.image, 'thumb') }));
---
{cards.length > 0 && (
  <section class="related-links" aria-label={heading}>
    <h2 class="related-links__heading">{heading}</h2>
    {note && <p class="related-links__note">{note}</p>}
    <ul class="related-links__grid">
      {withPhoto.map(({ card, photo }) => (
        <li class="related-links__item">
          <a href={card.url} class:list={['related-links__link', photo && 'related-links__link--photo']}>
            {photo && (
              <span class="related-links__media">
                <img src={photo} alt="" data-decorative loading="lazy" decoding="async" width="240" height="240" />
              </span>
            )}
            <span class="related-links__body">
              <span class="related-links__badge">{card.label}</span>
              <span class="related-links__title">{card.title}</span>
              <span class="related-links__desc">{card.description}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .related-links { margin: 3rem 0 0; }
  .related-links__heading {
    font-size: 1.35rem;
    margin: 0 0 0.35rem;
    color: var(--color-ink);
  }
  .related-links__note {
    margin: 0 0 1.25rem;
    font-size: 0.9rem;
    color: var(--color-muted);
  }
  .related-links__grid {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .related-links__grid { grid-template-columns: 1fr 1fr; }
  }
  .related-links__link {
    display: block;
    height: 100%;
    padding: 0.9rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-photo);
    background: var(--color-surface);
    text-decoration: none;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .related-links__link:hover {
    border-color: var(--color-accent);
    transform: translateY(-1px);
  }
  .related-links__link--photo {
    display: flex;
    align-items: stretch;
    gap: 0;
    padding: 0;
    overflow: hidden;
  }
  .related-links__media {
    flex: 0 0 96px;
    width: 96px;
    min-height: 96px;
    align-self: stretch;
    overflow: hidden;
    background: var(--color-surface-muted);
    border-right: 1px solid var(--color-border-soft);
  }
  .related-links__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .related-links__body { display: block; padding: 0.85rem 1rem; }
  @media (max-width: 400px) {
    .related-links__media { flex-basis: 76px; width: 76px; min-height: 76px; }
  }
  .related-links__badge {
    display: inline-block;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.35rem;
  }
  .related-links__title {
    display: block;
    font-weight: 600;
    font-size: 0.95rem;
    line-height: 1.35;
    color: var(--color-ink);
    margin-bottom: 0.3rem;
  }
  .related-links__desc {
    display: block;
    font-size: 0.82rem;
    line-height: 1.45;
    color: var(--color-muted);
  }
</style>
