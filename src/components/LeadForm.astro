---
import { SITE } from '../data/site';

interface Props {
  title?: string;
  subtitle?: string;
  context?: string;
  formLocation?: 'top' | 'mid' | 'bottom';
}

const {
  title = 'Get your Mexico property shortlist',
  subtitle = 'Share your budget and target market. We respond within one business day.',
  context = '',
  formLocation = 'top',
} = Astro.props;

const waText = encodeURIComponent(
  'Hi, I need help with a Mexico property enquiry from Mexico Invest.',
);
const waHref = `${SITE.whatsapp}?text=${waText}`;
---
<section class="surface-card p-8 md:p-10" id="lead-form">
  <span class="badge-pill mb-3">Free · Independent advisory</span>
  <h2 class="text-2xl mb-1 text-[var(--color-ink)]">{title}</h2>
  <p class="text-[var(--color-muted)] mb-5 text-sm">{subtitle}</p>

  <form class="grid gap-4 ig-lead-form" id="ig-lead-form" data-context={context} data-form-location={formLocation} novalidate>
    <div>
      <label class="block text-xs font-medium mb-1" for="lf-name">Your name *</label>
      <input type="text" id="lf-name" name="name" required placeholder="John Smith" autocomplete="name" class="w-full" />
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label class="block text-xs font-medium mb-1" for="lf-email">Email *</label>
        <input type="email" id="lf-email" name="email" placeholder="john@example.com" autocomplete="email" />
      </div>
      <div>
        <label class="block text-xs font-medium mb-1" for="lf-phone">WhatsApp / Phone</label>
        <input type="tel" id="lf-phone" name="phone" placeholder="+1 555 123 4567" autocomplete="tel" />
      </div>
    </div>
    <p class="-mt-2 text-xs text-[var(--color-muted)]">Email is enough. Add a number only if you want a WhatsApp reply.</p>
    <div>
      <label class="block text-xs font-medium mb-1" for="lf-budget">Budget (USD)</label>
      <select id="lf-budget" name="budget" class="w-full">
        <option value="">Select budget</option>
        <option value="under-150k">Under $150k</option>
        <option value="150-300k">$150k to $300k</option>
        <option value="300-500k">$300k to $500k</option>
        <option value="500k-1m">$500k to $1M</option>
        <option value="1m-2m">$1M to $2M</option>
        <option value="2m+">$2M+</option>
      </select>
    </div>
    <div>
      <label class="block text-xs font-medium mb-1" for="lf-message">Tell us about your requirements</label>
      <textarea id="lf-message" name="message" rows="3" placeholder="E.g. 2BR condo in Riviera Maya, rental income focus, ready to close in 3 months…"></textarea>
    </div>
    <div class="lead-form-hp" aria-hidden="true">
      <label for="lf-company">Company (leave blank)</label>
      <input type="text" id="lf-company" name="company" tabindex="-1" autocomplete="off" />
    </div>
    <div class="lead-form-consent">
      <input type="checkbox" id="lf-consent" name="consent" required class="lead-form-consent__check" />
      <label class="lead-form-consent__label" for="lf-consent">I agree to be contacted about my enquiry. See our <a href="/privacy-policy/">Privacy Policy</a>.</label>
    </div>
    <button type="submit" class="btn-primary w-full py-3">Get my Mexico shortlist →</button>
    <ul class="lead-form-next text-xs text-[var(--color-muted)]">
      <li>A researcher reads your request, usually within 15 minutes during US morning hours.</li>
      <li>You get 3 to 5 matched options with real net yield maths, not a developer brochure.</li>
      <li>No cold calls. We reply on the channel you gave us, and you can stop at any point.</li>
    </ul>
    <p class="text-center text-sm text-[var(--color-muted)]">
      Prefer WhatsApp?
      <a
        href={waHref}
        class="font-medium text-[var(--color-accent)] underline underline-offset-2"
        target="_blank"
        rel="noopener noreferrer"
        data-wa-placement="inline_cta"
        data-cta="whatsapp_lead_form"
      >
        Message us on WhatsApp
      </a>
    </p>
    <p id="lf-success" class="hidden text-green-700 text-sm font-medium text-center">Thank you. Taking you to the next step…</p>
    <p id="lf-error" class="hidden text-red-600 text-sm text-center">
      Something went wrong. Email {SITE.email} or{' '}
      <a
        href={SITE.whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        data-wa-placement="inline_cta"
        data-cta="whatsapp_form_error"
      >WhatsApp us</a>.
    </p>
  </form>
</section>

<script>
  import { getLeadAttribution, initializeLeadAttribution } from '../lib/lead-attribution';

  initializeLeadAttribution();

  /** `/guides/fideicomiso-mexico-explained/` -> { collection: 'guides', slug: 'fideicomiso-mexico-explained' } */
  function pageIdentity() {
    const parts = window.location.pathname.split('/').filter(Boolean);
    return {
      collection: parts.length > 1 ? parts[0] : 'root',
      slug: parts.length > 0 ? parts[parts.length - 1] : 'home',
    };
  }

  function ga(eventName: string, params: Record<string, unknown> = {}) {
    try {
      // @ts-ignore
      if (typeof window.investGulfTrack === 'function') {
        // @ts-ignore
        window.investGulfTrack(eventName, params);
        return;
      }
      // @ts-ignore
      if (typeof window.gtag === 'function') {
        // @ts-ignore
        window.gtag('event', eventName, params);
      }
      // @ts-ignore
      window.dataLayer = window.dataLayer || [];
      // @ts-ignore
      window.dataLayer.push({ event: eventName, ...params });
    } catch (_) {}
  }

  document.querySelectorAll('form.ig-lead-form').forEach((formEl) => {
    const form = formEl as HTMLFormElement;
    let started = false;
    const renderedAt = Date.now();

    form.addEventListener('focusin', () => {
      if (started) return;
      started = true;
      const { collection, slug } = pageIdentity();
      ga('form_start', {
        form_id: form.id,
        form_context: form.dataset.context || '',
        form_location: form.dataset.formLocation || 'top',
        page_path: window.location.pathname,
        collection,
        slug,
      });
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const phone = String(data.get('phone') || '').trim();
      const email = String(data.get('email') || '').trim();
      const hasPhone = phone.replace(/\D/g, '').length >= 8;
      const hasEmail = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email);
      if (!hasPhone && !hasEmail) {
        const err = document.getElementById('lf-error');
        if (err) {
          err.textContent = 'Please leave an email address, or a phone number we can reach you on.';
          err.classList.remove('hidden');
        }
        return;
      }
      const { collection, slug } = pageIdentity();
      const attribution = getLeadAttribution();
      const formLocation = form.dataset.formLocation || 'top';
      const payload = {
        name: data.get('name'),
        phone,
        email,
        contact: [phone, email].filter(Boolean).join(' / '),
        budget: data.get('budget'),
        message: data.get('message'),
        context: form.dataset.context || '',
        source: window.location.href,
        page: window.location.pathname,
        collection,
        slug,
        formLocation,
        sessionId: attribution.sessionId,
        landingPage: attribution.landingPage,
        referrer: attribution.firstReferrer,
        aiSource: attribution.externalAiSource,
        utm: attribution.utm,
        // Anti-spam: a hidden field no human sees, and how long the form was open.
        company: String(data.get('company') || ''),
        formElapsedMs: Date.now() - renderedAt,
      };

      ga('form_submit_attempt', {
        form_id: form.id,
        form_context: payload.context,
        form_location: formLocation,
        budget: payload.budget || 'not_set',
        page_path: window.location.pathname,
        collection,
        slug,
      });

      try {
        const res = await fetch('/api/lead/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (!res.ok) throw new Error('fail');
        document.getElementById('lf-success')?.classList.remove('hidden');
        ga('generate_lead', {
          form_id: form.id,
          form_context: payload.context,
          form_location: formLocation,
          lead_type: 'shortlist_form',
          budget: payload.budget || 'not_set',
          page_path: window.location.pathname,
          collection,
          slug,
          value: 1,
          currency: 'USD',
        });
        // `generate_lead` is fired here only. /thanks/ must not fire it again.
        const thanksUrl = new URL('/thanks/', window.location.origin);
        thanksUrl.searchParams.set('lead', '1');
        thanksUrl.searchParams.set('from', window.location.pathname);
        if (payload.context) thanksUrl.searchParams.set('context', String(payload.context).slice(0, 80));
        setTimeout(() => {
          window.location.assign(thanksUrl.toString());
        }, 400);
      } catch {
        document.getElementById('lf-error')?.classList.remove('hidden');
        ga('form_submit_error', {
          form_id: form.id,
          form_context: payload.context,
          form_location: formLocation,
          page_path: window.location.pathname,
          collection,
          slug,
        });
      }
    });
  });
</script>
