---
import BaseLayout from '../../layouts/BaseLayout.astro';
import credits from '../../../scripts/data/image-credits.json';

/*
 * The table used to be hand-written markup, which meant the licence
 * obligations and the images actually in use could drift apart silently.
 * It renders from scripts/data/image-credits.json instead, and the hero
 * replacement tool writes to that same file, so a photograph cannot enter the
 * corpus without its attribution arriving with it.
 */
type Credit = {
  page: string;
  pageLabel: string;
  sourceUrl: string;
  fileTitle: string;
  licence: string;
  licenceUrl: string;
  author: string;
};

const rows = ([...credits] as Credit[]).sort((a, b) => a.pageLabel.localeCompare(b.pageLabel));
---
<BaseLayout
  title="Image Credits"
  description="Attribution and licence terms for the Wikimedia Commons photography used across Mexico Invest."
>
  <section class="site-container py-12 md:py-16 max-w-5xl">
    <h1 class="mb-6">Image credits</h1>
    <div class="prose">
      <p>
        Hero photography on this site is sourced from <a href="https://commons.wikimedia.org/" rel="noopener" target="_blank">Wikimedia Commons</a>
        under open licences. Images are resized and re-encoded for delivery; no other modification is made.
        Where a licence requires share-alike terms, the licence link below governs reuse of that image.
      </p>
      <p>{rows.length} images, listed by the page each one appears on.</p>
      <div style="overflow-x:auto">
      <table>
        <thead><tr><th>Page</th><th>Source file</th><th>Licence</th><th>Author</th></tr></thead>
        <tbody>
        {rows.map((row) => (
          <tr>
            <td><a href={row.page}>{row.pageLabel}</a></td>
            <td><a href={row.sourceUrl} rel="noopener" target="_blank">{row.fileTitle}</a></td>
            <td>
              {row.licenceUrl
                ? <a href={row.licenceUrl} rel="license noopener" target="_blank">{row.licence}</a>
                : row.licence}
            </td>
            <td>{row.author}</td>
          </tr>
        ))}
        </tbody>
      </table>
      </div>
      <p>
        Project photography supplied by developers is used with their permission and is not listed here.
        See <a href="/methodology/">methodology</a> for how we source and check everything else.
      </p>
    </div>
  </section>
</BaseLayout>
