---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCardImageUrl } from '../../lib/cardImage';

/* The sources brief taken literally: the Archivo General de la Nacion, in the
 * old Lecumberri building. Deliberately not the Registro Publico de la
 * Propiedad in the Federal District, which the corpus already uses twice. */
const heroSrc = getCardImageUrl(
  'https://res.cloudinary.com/dlrrtf6bq/image/upload/v1788438366/more-group/mexico/pages/methodology/hero.jpg',
  'hero',
);
---
<BaseLayout
  title="Research Methodology"
  description="How Mexico Invest researches Mexico property data: sources, limitations, and partner referral policy."
>
  <section class="site-container py-12 md:py-16 max-w-3xl">
    <h1 class="mb-6">Methodology</h1>
    <figure class="page-hero">
      <img
        src={heroSrc}
        alt="Castellated stone wing of Mexico's national archive"
        width="1600"
        height="640"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <figcaption>The Archivo General de la Nacion, Mexico City. <a href="/image-credits/">Image credits</a>.</figcaption>
    </figure>

    <div class="prose">
      <p>
        Our guides combine publicly available regulatory sources (SAT, SRE, RAN, state public registries, municipal
        lodging registries and INM visa rules), market reports, and cross-checks against multiple listing platforms.
        Figures are rounded and dated: markets move quickly.
      </p>
      <h2>Sources we prioritise</h2>
      <ul>
        <li>Official Mexican federal and state-level portals (SAT, RAN, state registries)</li>
        <li>Licensed broker market commentary (clearly labelled as third-party)</li>
        <li>Transaction fee schedules published by land departments</li>
      </ul>
      <h2>Lead referral policy</h2>
      <p>
        When you submit the shortlist form, your enquiry may be shared with a <strong>AMPI-licensed partner</strong>
        who can show regulated inventory and complete KYC. We do not sell your data to unrelated marketing lists.
      </p>
      <h2>Image credits</h2>
      <p>
        Photography on this site comes from Wikimedia Commons under open licences (CC0, CC BY, CC BY-SA and
        public domain), plus licensed developer material where a project supplied it. Each hero image keeps the
        original file name in its Cloudinary path, so the source file on Commons is traceable from the URL.
        Attribution and licence terms for every Commons image we use are listed in
        <a href="/image-credits/">image credits</a>.
      </p>
      <h2>Updates</h2>
      <p>
        Each guide shows an <em>Updated</em> date when material facts change (visa thresholds, fee changes, major market shifts).
        Always confirm numbers with your lawyer and broker before signing.
      </p>
    </div>
  </section>
</BaseLayout>
