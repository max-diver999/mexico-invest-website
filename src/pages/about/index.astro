---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCardImageUrl } from '../../lib/cardImage';
import { SITE } from '../../data/site';

/* The page was a wall of short text ending in half a screen of nothing. A
 * restored mansion on Paseo de Montejo says Mexican housing rather than
 * Mexican holiday, which is the distinction this page exists to draw. */
const heroSrc = getCardImageUrl(
  'https://res.cloudinary.com/dlrrtf6bq/image/upload/v1788438365/more-group/mexico/pages/about/hero.jpg',
  'hero',
);
---
<BaseLayout
  title="About Mexico Invest: Independent Property Research"
  description="Mexico Invest is an independent editorial resource on Mexico property investment: not a developer or listing portal."
>
  <section class="site-container py-12 md:py-16 max-w-3xl">
    <h1 class="mb-6">About {SITE.name}</h1>
    <figure class="page-hero">
      <img
        src={heroSrc}
        alt="Restored mansion facade on Paseo de Montejo, Merida"
        width="1600"
        height="640"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <figcaption>A restored mansion on Paseo de Montejo, Merida. <a href="/image-credits/">Image credits</a>.</figcaption>
    </figure>

    <div class="prose">
      <p>
        {SITE.name} publishes research-first guides for foreign buyers evaluating Riviera Maya, Los Cabos, and wider Gulf markets.
        We are <strong>not</strong> a developer, not a property portal, and not a substitute for licensed legal or tax advice.
      </p>
      <h2>What we do</h2>
      <ul>
        <li>Explain ownership rules, fee stacks, and fideicomiso thresholds in plain English</li>
        <li>Compare markets and product types (off-plan vs ready, yield vs capital growth)</li>
        <li>Connect serious enquiries to <strong>AMPI-licensed partners</strong> when you request a shortlist</li>
      </ul>
      <h2>What we don't do</h2>
      <ul>
        <li>Push specific developer inventory or take undisclosed referral fees without disclosure</li>
        <li>Guarantee yields, capital appreciation, or visa outcomes</li>
        <li>Provide personalised financial, legal, or tax advice</li>
      </ul>
      <p>
        Questions? Email <a href={`mailto:${SITE.email}`}>{SITE.email}</a> or read our
        <a href="/methodology/">methodology</a>.
      </p>
    </div>
  </section>
</BaseLayout>
