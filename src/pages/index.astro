---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadForm from '../components/LeadForm.astro';
import ContentCard from '../components/ContentCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import {
  FEATURED_PROJECT_SLUGS,
  FEATURED_GUIDE_SLUGS,
  FEATURED_AREA_SLUGS,
  HOMEPAGE_HERO_IMAGE,
  HOMEPAGE_HERO_PROJECT_SLUG,
} from '../data/featured';
import { getCardImageUrl, formatAreaLabel } from '../lib/cardImage';
import { pickHomepageProjects, projectHeroLine } from '../lib/homeProjects';

const [guides, projects, areas] = await Promise.all([
  getCollection('guides'),
  getCollection('projects'),
  getCollection('areas'),
]);

const publishedGuides = guides.filter((g) => !g.data.noindex);
const publishedProjects = projects.filter((p) => !p.data.noindex);
const publishedAreas = areas.filter((a) => !a.data.noindex);

const guideBySlug = new Map(publishedGuides.map((g) => [g.id, g]));
const projectBySlug = new Map(publishedProjects.map((p) => [p.id, p]));
const areaBySlug = new Map(publishedAreas.map((a) => [a.id, a]));

const featuredGuides = FEATURED_GUIDE_SLUGS.map((slug) => guideBySlug.get(slug)).filter(Boolean);
const homepageProjects = pickHomepageProjects(publishedProjects, FEATURED_PROJECT_SLUGS, 12);
const heroProject = projectBySlug.get(HOMEPAGE_HERO_PROJECT_SLUG) ?? homepageProjects[0];
const featuredAreas = FEATURED_AREA_SLUGS.map((slug) => areaBySlug.get(slug)).filter(Boolean);

// The hero photograph and the plate under it must name the same building.
const heroImage = getCardImageUrl(HOMEPAGE_HERO_IMAGE ?? heroProject?.data.heroImage, 'panel');
const heroProjectName = heroProject
  ? heroProject.data.title.replace(/ Review:.*$/, '').replace(/ 2026.*$/, '').replace(/:.*$/, '')
  : '';

const rail = [
  { n: publishedGuides.length, label: 'Guides', href: '/guides/' },
  { n: publishedProjects.length, label: 'Projects', href: '/projects/' },
  { n: publishedAreas.length, label: 'Areas', href: '/areas/' },
];
---
<BaseLayout
  title="Mexico Real Estate for Foreign Buyers: From $130K 2026"
  description="Compare Mexico property from $130K, realistic 3-5% net yields, fideicomiso rules, and vetted projects. Request a free shortlist for your budget."
>
  <section class="hero-band on-deep">
    <div class="site-container hero-band__inner">
      <div class="hero-band__copy">
        <p class="hero-band__eyebrow">Not a developer · Independent research</p>
        <h1>Mexico property for foreign buyers, from $130K</h1>
        <div class="hero-band__rule" aria-hidden="true"></div>
      </div>

      <div class="hero-band__aside">
        <p class="hero-band__deck">
          Riviera Maya condos start near $130,000 USD via fideicomiso. We publish the net yield after HOA,
          management and IVA, the fideicomiso costs, and the closing timeline — the arithmetic a developer
          deck leaves out.
        </p>
        <div class="hero-band__acts">
          <a href="/get-shortlist/" class="btn-primary">Get my shortlist</a>
          <a href="/projects/" class="btn-secondary">Browse {publishedProjects.length} reviews</a>
        </div>
        <div class="hero-band__rail">
          {rail.map((r) => (
            <a href={r.href} class="hero-band__chip"><b>{r.n}</b> {r.label.toUpperCase()}</a>
          ))}
        </div>
      </div>
    </div>

    <figure class="hero-photo">
      <img
        src={heroImage}
        alt={heroProject
          ? `${heroProjectName}, ${formatAreaLabel(heroProject.data.area)} — featured Mexico project review`
          : 'Featured Mexico project'}
        loading="eager"
        fetchpriority="high"
        width="2000"
        height="860"
      />
      <div class="hero-photo__fall" aria-hidden="true"></div>
      {heroProject && (
        <div class="hero-photo__plate-wrap">
          <div class="site-container">
            <a href={`/projects/${heroProject.id}/`} class="hero-plate">
              <p class="hero-plate__eyebrow">In the photograph</p>
              <p class="hero-plate__title">{heroProjectName}</p>
              <p class="hero-plate__meta">{projectHeroLine(heroProject)}</p>
            </a>
          </div>
        </div>
      )}
    </figure>
  </section>

  <section class="section-deep">
    <div class="site-container">
      <div class="stat-strip">
        <div>
          <strong>40,000+</strong>
          <span>Foreign purchases last year</span>
        </div>
        <div>
          <strong>~65%</strong>
          <span>Of those buyers from the US</span>
        </div>
        <div>
          <strong>4-5%</strong>
          <span>Net on managed Playa STR</span>
        </div>
        <div>
          <strong>$130K+</strong>
          <span>Entry from (USD)</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-[var(--color-surface)] border-b border-[var(--color-border-soft)]">
    <div class="site-container max-w-xl">
      <LeadForm
        title="Get a Mexico property shortlist"
        subtitle="Independent research, local due diligence, and no developer sales deck. Share your budget and target market; we reply within one business day."
        context="Homepage shortlist"
      />
    </div>
  </section>

  <section class="section">
    <div class="site-container">
      <div class="flex items-end justify-between gap-4 mb-8">
        <div>
          <h2 class="text-2xl mb-2">Featured project reviews</h2>
          <p class="text-[var(--color-muted)]">Click through for pricing, photos, yield math, and due diligence, not developer brochures.</p>
        </div>
        <a href="/projects/" class="link-arrow shrink-0 hidden sm:inline">All {publishedProjects.length} projects →</a>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
        {homepageProjects.map((project) => (
          <ProjectCard
            href={`/projects/${project.id}/`}
            title={project.data.title}
            description={project.data.description}
            image={project.data.heroImage}
            area={project.data.area}
            developer={project.data.developer}
            propertyType={project.data.propertyType}
            status={project.data.status}
            priceFromUsd={project.data.priceFromUsd}
          />
        ))}
      </div>
      <div class="mt-8 text-center sm:hidden">
        <a href="/projects/" class="btn-secondary px-6 py-3">Browse all {publishedProjects.length} projects</a>
      </div>
    </div>
  </section>

  <section class="section bg-[var(--color-surface)] border-y border-[var(--color-border-soft)]">
    <div class="site-container">
      <div class="flex items-end justify-between gap-4 mb-8">
        <div>
          <h2 class="text-2xl mb-2">Start here</h2>
          <p class="text-[var(--color-muted)]">High-intent guides for foreign buyers.</p>
        </div>
        <a href="/guides/" class="link-arrow shrink-0 hidden sm:inline">All guides →</a>
      </div>
      <div class="grid sm:grid-cols-2 gap-5">
        {featuredGuides.map((guide) => (
          <ContentCard
            href={`/guides/${guide.id}/`}
            title={guide.data.title}
            description={guide.data.description}
            image={guide.data.heroImage}
            badges={['Guide', ...(guide.data.tags?.slice(0, 1) ?? [])]}
            meta={`${guide.data.readingTime ?? 8} min read`}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="site-container">
      <div class="flex items-end justify-between gap-4 mb-8">
        <div>
          <h2 class="text-2xl mb-2">Investment areas</h2>
          <p class="text-[var(--color-muted)]">Micro-market guides: yields, buyer fit, and red flags.</p>
        </div>
        <a href="/areas/" class="link-arrow shrink-0 hidden sm:inline">All areas →</a>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {featuredAreas.map((area) => (
          <ContentCard
            href={`/areas/${area.id}/`}
            title={area.data.title}
            description={area.data.description}
            image={area.data.heroImage}
            badges={['Area', formatAreaLabel(area.id)]}
            meta={`${area.data.readingTime ?? 10} min read`}
          />
        ))}
      </div>
    </div>
  </section>

</BaseLayout>
