{
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.mexico-invest.com"
        }
      ],
      "destination": "https://mexico-invest.com/$1",
      "statusCode": 308
    },
    {
      "source": "/areas/holistika-tulum/",
      "destination": "/projects/holistika-tulum/",
      "permanent": true
    },
    {
      "source": "/areas/tankah-bay/",
      "destination": "/projects/tankah-bay/",
      "permanent": true
    },
    {
      "source": "/areas/tulum-country-club/",
      "destination": "/projects/tulum-country-club/",
      "permanent": true
    },
    {
      "source": "/guides/tier-entry/",
      "destination": "/guides/mexico-property-under-250k/",
      "permanent": true
    },
    {
      "source": "/guides/tier-mid/",
      "destination": "/guides/mexico-property-300k-budget/",
      "permanent": true
    },
    {
      "source": "/guides/tier-luxury/",
      "destination": "/guides/luxury-mexico-property-500k-plus/",
      "permanent": true
    },
    {
      "source": "/guides/isr-exemption-5-year-rule/",
      "destination": "/guides/isr-exemption-casa-habitacion/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
